                              characters long.}
                          description: {description: A description of this Reserve.
                              This field is stored as a text string and must be between
                              0 and 100 characters long.}
                          percent: {description: 'The percentage of funds to reserve,
                              expressed in basis points. For example, 25.3% is expressed
                              as ''2530''.'}
                          release:
